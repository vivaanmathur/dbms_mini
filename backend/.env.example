# Copy this file to backend/.env and fill in the values (see docs/SETUP.md).
# .env itself is gitignored so the password never reaches GitHub.

DB_HOST=
DB_PORT=3306
DB_NAME=
DB_USER=
DB_PASSWORD=

# python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=
JWT_EXPIRE_MINUTES=480

CORS_ORIGINS=http://localhost:5173
